# syntax=docker/dockerfile:1

ARG BASE_IMAGE=${BASE_IMAGE:-nvcr.io/nvidia/isaac-lab:2.1.0}
ARG ROS_DISTRO=humble
ARG DEBIAN_FRONTEND=noninteractive

FROM ${BASE_IMAGE}

ENV ACCEPT_EULA=Y \
    PRIVACY_CONSENT=Y \
    ROS_DISTRO=${ROS_DISTRO} \
    RMW_IMPLEMENTATION=rmw_fastrtps_cpp \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    OMNI_KIT_ALLOW_ROOT=1

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
USER root

# ============================================================
# Layer 1: Base system utilities
# ============================================================
RUN if ! grep -q "^deb .* jammy universe" /etc/apt/sources.list; then \
        echo "deb http://archive.ubuntu.com/ubuntu jammy universe" >> /etc/apt/sources.list; \
    fi \
    && sed -i 's/^deb .*security.ubuntu.com.*jammy-security/# disabled: clock skew - &/' /etc/apt/sources.list \
    && apt-get update --allow-releaseinfo-change && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg2 \
        locales \
        lsb-release \
        software-properties-common \
        sudo \
        tzdata \
        vim \
        wget \
        git \
        build-essential \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# Layer 2: Isaac Lab verification
# ============================================================
RUN echo "=== Verifying Isaac Lab base image ===" \
    && echo "IsaacSim path: ${ISAACSIM_PATH:-not set}" \
    && if [ -f "/isaac-sim/python.sh" ]; then \
        echo "Using IsaacSim python.sh"; \
        /isaac-sim/python.sh -c "import sys; print('Python:', sys.version); import torch; print('PyTorch:', torch.__version__); print('CUDA:', torch.cuda.is_available())"; \
    elif [ -f "/isaac-lab/setup_conda_env.sh" ]; then \
        echo "Using IsaacLab conda env"; \
        bash -c "source /isaac-lab/setup_conda_env.sh && python -c 'import sys; print(sys.version); import torch; print(torch.__version__); print(torch.cuda.is_available())'"; \
    else \
        echo "Warning: Could not verify PyTorch - no IsaacSim/IsaacLab python found"; \
        python3 -c "import sys; print('Python:', sys.version)" || true; \
    fi \
    && echo "=== Isaac Lab base verified ==="

# ============================================================
# Layer 3: ROS2 repository setup
# ============================================================
RUN apt-get update --allow-releaseinfo-change \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu jammy main" \
        > /etc/apt/sources.list.d/ros2.list

# ============================================================
# Layer 4: ROS2 packages
# ============================================================
RUN apt-get update --allow-releaseinfo-change && apt-get install -y --no-install-recommends \
        ros-humble-ros-base \
        ros-humble-demo-nodes-cpp \
        ros-humble-demo-nodes-py \
        ros-humble-rmw-fastrtps-cpp \
        python3-colcon-common-extensions \
        python3-rosdep \
        python3-vcstool \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# Layer 5: ROS2 environment setup
# ============================================================
RUN rosdep init || true \
    && rosdep update || true \
    && printf '%s\n' \
        "source /opt/ros/humble/setup.bash" \
        "export ROS_DISTRO=humble" \
        "export RMW_IMPLEMENTATION=rmw_fastrtps_cpp" \
        "export ROS_DOMAIN_ID=0" \
        > /etc/profile.d/ros2.sh \
    && printf '%s\n' \
        "" \
        "# ROS 2 environment" \
        "source /opt/ros/humble/setup.bash" \
        "export RMW_IMPLEMENTATION=rmw_fastrtps_cpp" \
        >> /etc/bash.bashrc

# Isaac Sim ROS2 bridge lib path
RUN if [ -d "/isaac-sim/exts/isaacsim.ros2.bridge" ]; then \
        echo "export LD_LIBRARY_PATH=\$LD_LIBRARY_PATH:/isaac-sim/exts/isaacsim.ros2.bridge/humble/lib" >> /etc/profile.d/ros2.sh; \
    fi

# ============================================================
# Layer 6: Entrypoint script
# ============================================================
COPY docker/entrypoint.sh /usr/local/bin/isaac-ros-entrypoint.sh
RUN chmod +x /usr/local/bin/isaac-ros-entrypoint.sh

# ============================================================
# Layer 7: Primitives (framework code)
# ============================================================
WORKDIR /workspace
COPY primitives /workspace/primitives

ENTRYPOINT ["/usr/local/bin/isaac-ros-entrypoint.sh"]
CMD ["sleep", "infinity"]
