# syntax=docker/dockerfile:1

# Visualization image: builds on top of the fully-built Isaac RL Studio image
# and adds a browser-based viewer (Xvfb + x11vnc + noVNC/websockify).
# View the simulation at http://localhost:6080/vnc.html
ARG VIZ_BASE=${VIZ_BASE:-isaac-rl-studio:2.1.0-humble}
FROM ${VIZ_BASE}

ARG DEBIAN_FRONTEND=noninteractive

ENV DISPLAY=:99 \
    VIZ_MODE=1 \
    VIZ_PORT=${VIZ_PORT:-6080} \
    VNC_PORT=${VNC_PORT:-5900}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
USER root

# Layer V1: Virtual display + VNC + noVNC web client (all additive on top of the base image)
RUN apt-get update --allow-releaseinfo-change && apt-get install -y --no-install-recommends \
        xvfb \
        x11vnc \
        websockify \
        novnc \
        fluxbox \
        x11-utils \
        procps \
    && rm -rf /var/lib/apt/lists/*

# Layer V2: Shared entrypoint (idempotent: can be sourced by docker exec too).
# VIZ_MODE=1 (set above) makes it start Xvfb + x11vnc + noVNC.
COPY docker/entrypoint.sh /usr/local/bin/isaac-ros-entrypoint.sh
RUN chmod +x /usr/local/bin/isaac-ros-entrypoint.sh

EXPOSE 6080 5900

ENTRYPOINT ["/usr/local/bin/isaac-ros-entrypoint.sh"]
CMD ["sleep", "infinity"]
