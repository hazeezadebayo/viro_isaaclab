# Isaac RL Studio Default Configuration
# Override with: .\launcher.ps1 up -EnvFile .env.custom

# Base image selection
BASE_IMAGE=nvcr.io/nvidia/isaac-lab:2.1.0
ROS_DISTRO=humble

# Container settings
CONTAINER_NAME=isaac-rl-studio
HEAD_NAME=template
NO_GUI=0

# Isaac Sim / Lab settings
ACCEPT_EULA=Y
PRIVACY_CONSENT=Y
OMNI_KIT_ALLOW_ROOT=1
NVIDIA_DRIVER_CAPABILITIES=all

# ROS2 settings
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROS_DOMAIN_ID=0

# Networking (host mode for isaac-sim: recommended for ROS2 DDS discovery)
# isaac-viz always uses bridge + published ports (VIZ_PORT/VNC_PORT) for browser access.
NETWORK_MODE=host

# Display (for GUI mode - noVNC web interface)
# DISPLAY=:1
# NO_GUI=0

# Browser visualization (docker compose isaac-viz / launcher up --viz)
# VIZ_PORT=6080
# VNC_PORT=5900
# VIZ_CONTAINER_NAME=isaac-rl-studio-viz

# Auto-summoned IsaacLab task in the viz container (runs HEADLESS, no GUI viewport)
# VIZ_TASK=Isaac-Humanoid-v0
# VIZ_TASK=Isaac-Ant-v0
# VIZ_TASK=Isaac-Spider-v0
# VIZ_NUM_ENVS=4
# VIZ_MAX_ITERATIONS=100000
#
# Periodic video recording: record a short clip every N training steps (1 step =
# one vectorized env.step). Length is in frames (~30 fps in the mp4). With
# defaults, a ~60-90s clip is written every ~2000 steps.
# VIZ_VIDEO=1
# VIZ_VIDEO_INTERVAL=2000
# VIZ_VIDEO_LENGTH=2000
#
# TensorBoard (auto-started by the entrypoint; view training live in the browser)
# TENSORBOARD_PORT=6006
